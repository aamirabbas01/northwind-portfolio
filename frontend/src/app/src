// middleware.ts
import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';

export function middleware(request: NextRequest) {
    // 1. Extract the JWT token from the incoming request cookies
    const token = request.cookies.get('token')?.value;
    const { pathname } = request.nextUrl;

    // 2. Define protected routes
    const isDashboardRoute = pathname.startsWith('/Dashboard');

    // 3. If trying to access the dashboard without a token, redirect to login
    if (isDashboardRoute && !token) {
        const loginUrl = new URL('/login', request.url);
        return NextResponse.redirect(loginUrl);
    }

    // 4. Protip: If they are logged in and try to visit /login, bounce them to the dashboard
    if (pathname === '/login' && token) {
        const dashboardUrl = new URL('/Dashboard', request.url);
        return NextResponse.redirect(dashboardUrl);
    }

    return NextResponse.next();
}

// 5. Specify exactly which routes this middleware should run against
export const config = {
    matcher: ['/Dashboard/:path*', '/login'],
};
