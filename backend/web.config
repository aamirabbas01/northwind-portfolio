<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <!-- Directs all incoming traffic to the HttpPlatformHandler -->
      <add name="HttpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    
    <!-- 
      processPath: The absolute path to your system node execution file.
      arguments: Change "index.js" below to match your entry file (e.g. "server.js" or "bin/www").
    -->
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe" 
              arguments=".\src\server.js"
              stdoutLogEnabled="true" 
              stdoutLogFile=".\logs\stdout.log" 
              startupTimeLimit="120">
      <environmentVariables>
        <!-- Crucial: Passes the dynamic IIS port mapping straight to your Node app environment variable -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
